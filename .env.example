# ──────────────────────────────────────────────────────────────
# NexChat — Environment Variable Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# Appwrite API endpoint (cloud or self-hosted)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (from Project Settings > Overview)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Your Appwrite database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# ID of the 'users' collection
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=

# ID of the 'messages' collection
NEXT_PUBLIC_APPWRITE_MESSAGES_COLLECTION_ID=
